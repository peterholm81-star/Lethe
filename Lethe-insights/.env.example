# ==============================================================================
# Lethe Insights — Environment Variables
# ==============================================================================
# Copy this file to .env.local and fill in real values.
#   cp .env.example .env.local        (Mac/Linux)
#   Copy-Item .env.example .env.local (PowerShell)
#
# Vite exposes variables prefixed with VITE_ to the browser.
# NEVER put service-role keys or server-only secrets here.
# ==============================================================================

# --- Supabase -----------------------------------------------------------------
# Project URL from Supabase Dashboard → Settings → API → Project URL
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Anon (public) key from Supabase Dashboard → Settings → API → anon / public
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.PLACEHOLDER

# --- Mapbox -------------------------------------------------------------------
# Access token from https://account.mapbox.com/access-tokens/
VITE_MAPBOX_TOKEN=pk.PLACEHOLDER

# --- Debug (optional) ---------------------------------------------------------
# Set to "1" to enable verbose RPC debug logs in the browser console
# VITE_INSIGHTS_DEBUG=0

# Set to "true" to enable insights consistency checker (dev only)
# VITE_DEBUG_INSIGHTS=false
